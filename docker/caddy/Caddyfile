(maintenance_json) {
	header Content-Type "application/json; charset=utf-8"
	header Cache-Control "no-store"
	respond `{"message":"maintenance"}` 503
}

(proxy_upstream) {
	reverse_proxy {$CADDY_UPSTREAM:https://www.e-recht24.de} {
		header_up Host {upstream_hostport}
		@redirected status 301 302 303 307 308
		handle_response @redirected {
			rewrite {rp.header.Location}
			uri path_regexp "^https?://[^/]+(/.*)?$" "$1"
			reverse_proxy {$CADDY_UPSTREAM:https://www.e-recht24.de} {
				header_up Host {upstream_hostport}
			}
		}
	}
}

:80 {
	@acceptJson header Accept *application/json*
	handle @acceptJson {
		import maintenance_json
	}

	@contentJson header Content-Type *application/json*
	handle @contentJson {
		import maintenance_json
	}

	@files path_regexp files \.[A-Za-z0-9]{1,8}$
	handle @files {
		import proxy_upstream
	}

	handle {
		rewrite * {$CADDY_UPSTREAM_PATH:/}
		import proxy_upstream
	}
}
